# Conventional Commits Check
# Format: type(scope): subject

commit_msg=$(cat "$1")

# Regex für Conventional Commits
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore)(\(.+\))?: .{1,}"; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Commit message must follow Conventional Commits:"
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "Types: feat, fix, docs, style, refactor, perf, test, chore"
  echo ""
  echo "Examples:"
  echo "  feat(timer): add custom duration selector"
  echo "  fix(auth): resolve iOS Google Sign-In issue"
  echo "  refactor: improve Settings component structure"
  echo ""
  echo "Your message:"
  echo "  $commit_msg"
  echo ""
  exit 1
fi

exit 0
