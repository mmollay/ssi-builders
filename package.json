{
  "name": "@ssi/builders",
  "version": "2.13.0",
  "description": "Professional UI Builder Components - Material Design 3 | SSI Central Component Library",
  "main": "src/index.js",
  "module": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./ListBuilder": "./src/ListBuilder.js",
    "./FormBuilder": "./src/FormBuilder.js",
    "./ModalBuilder": "./src/ModalBuilder.js",
    "./ChartBuilder": "./src/ChartBuilder.js",
    "./TabBuilder": "./src/TabBuilder.js",
    "./MenuBuilder": "./src/MenuBuilder.js",
    "./SidebarBuilder": "./src/SidebarBuilder.js",
    "./styles": "./dist/ssi-builders.css",
    "./styles/*": "./src/*.css",
    "./AnalyticsCard": "./src/AnalyticsCard.js",
    "./FilterBar": "./src/FilterBar.js",
    "./TimeRangePicker": "./src/TimeRangePicker.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "start-server-and-test dev http://localhost:5177 test:tooltip",
    "test:tooltip": "playwright test tests/test-tooltip-builder.spec.js",
    "test:headed": "playwright test --headed",
    "version:sync": "node scripts/sync-version.js",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "prepare": "husky"
  },
  "keywords": [
    "ui",
    "builder",
    "components",
    "material-design",
    "md3",
    "forms",
    "modals",
    "tables",
    "charts",
    "ssi"
  ],
  "author": "SSI Solutions",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "start-server-and-test": "^2.1.3",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ssi-solutions/ssi-builders.git"
  },
  "bugs": {
    "url": "https://github.com/ssi-solutions/ssi-builders/issues"
  },
  "homepage": "https://github.com/ssi-solutions/ssi-builders#readme",
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
