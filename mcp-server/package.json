{
  "name": "ssi-builders-mcp",
  "version": "1.0.0",
  "description": "MCP Server for SSI Builders - Provides AI-optimized access to component documentation and code generation",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "ssi-builders-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js && mkdir -p build/data && cp src/data/*.json build/data/",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "sync": "ts-node scripts/sync-from-ssi-builders.ts && npm run build"
  },
  "keywords": [
    "mcp",
    "ssi-builders",
    "material-design",
    "ui-components",
    "ai-tools"
  ],
  "author": "SSI Solutions",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
